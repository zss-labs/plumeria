{
  "framework": null,
  "buildCommand": "pnpm build && pnpm --filter plumeria-docs build",
  "outputDirectory": "docs/dist/public",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/blog/component-libraries-without-a-runtime",
      "destination": "/blog/ui-libraries-without-a-runtime",
      "permanent": true
    },
    {
      "source": "/blog/eating-up-the-libraries",
      "destination": "https://refirst11.vercel.app/posts/2026-05-10",
      "permanent": true
    },
    {
      "source": "/docs/api-reference/javascript/viewTransition",
      "destination": "/docs/api/javascript/viewTransitionClass",
      "permanent": true
    },
    {
      "source": "/docs/api-reference/javascript/wind",
      "destination": "/docs/api/packages/wind",
      "permanent": true
    },
    {
      "source": "/docs/api-reference/wind",
      "destination": "/docs/api/packages/wind",
      "permanent": true
    },
    {
      "source": "/docs/api-reference/wind.md",
      "destination": "/docs/api/packages/wind.md",
      "permanent": true
    },
    {
      "source": "/docs/integration/component-library",
      "destination": "/docs/creating-packages",
      "permanent": true
    },
    {
      "source": "/docs/integration/component-library.md",
      "destination": "/docs/creating-packages.md",
      "permanent": true
    },
    {
      "source": "/docs/api-reference/tools/:path*",
      "destination": "/docs/api/migrate/:path*",
      "permanent": true
    },
    {
      "source": "/docs/api-reference/components/:path*",
      "destination": "/docs/api/packages/:path*",
      "permanent": true
    },
    {
      "source": "/docs/api-reference.md",
      "destination": "/docs/api.md",
      "permanent": true
    },
    {
      "source": "/docs/api-reference/:path*",
      "destination": "/docs/api/:path*",
      "permanent": true
    },
    {
      "source": "/docs/module-architecture",
      "destination": "/docs/thinking-in-plumeria",
      "permanent": true
    },
    {
      "source": "/docs/module-architecture.md",
      "destination": "/docs/thinking-in-plumeria.md",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/docs.md", "destination": "/llms.mdx/docs.md" },
    { "source": "/docs/:path*.md", "destination": "/llms.mdx/docs/:path*.md" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-DNS-Prefetch-Control", "value": "on" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/playground",
      "headers": [
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Cross-Origin-Embedder-Policy", "value": "require-corp" }
      ]
    },
    {
      "source": "/playground/:path*",
      "headers": [
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Cross-Origin-Embedder-Policy", "value": "require-corp" }
      ]
    },
    {
      "source": "/assets/:path*",
      "headers": [
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Cross-Origin-Embedder-Policy", "value": "require-corp" }
      ]
    }
  ]
}
